rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // .get() with a default: a user with no `admin` claim at all (e.g. an
    // email/password sign-up that never went through exchangeAuth0Token)
    // must count as "not admin" — reading a missing claim directly is a rules
    // evaluation ERROR, which denied those users even ordinary reads.
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isTourismAdmin() {
      return isAdmin()
        && request.auth.token.get('adminRole', 'tourism_admin') == 'tourism_admin';
    }

    function isMountainHead() {
      return isAdmin()
        && request.auth.token.get('adminRole', '') == 'mountain_head'
        && request.auth.token.get('managedMountainName', '') is string
        && request.auth.token.get('managedMountainName', '') != '';
    }

    function assignedMountainNameVariants() {
      let assigned = request.auth.token.get('managedMountainName', '');
      return assigned == 'Mt. Apo' || assigned == 'Mt Apo' || assigned == 'Mount Apo'
        ? ['Mt. Apo', 'Mt Apo', 'Mount Apo']
        : assigned == 'Mount Dinor' || assigned == 'Mt. Dinor' || assigned == 'Mt Dinor'
        ? ['Mount Dinor', 'Mt. Dinor', 'Mt Dinor']
        : assigned == 'Mount Loay' || assigned == 'Mt. Loay' || assigned == 'Mt Loay'
        ? ['Mount Loay', 'Mt. Loay', 'Mt Loay']
        : assigned == 'Mount Megatong' || assigned == 'Mt. Megatong' || assigned == 'Mt Megatong'
        ? ['Mount Megatong', 'Mt. Megatong', 'Mt Megatong']
        : assigned == 'Mt. Hamiguitan' || assigned == 'Mt Hamiguitan' || assigned == 'Mount Hamiguitan'
        ? ['Mt. Hamiguitan', 'Mt Hamiguitan', 'Mount Hamiguitan']
        : assigned == 'Mt. Kampalili' || assigned == 'Mt Kampalili' || assigned == 'Mount Kampalili'
        ? ['Mt. Kampalili', 'Mt Kampalili', 'Mount Kampalili']
        : assigned == 'Mt. Talomo' || assigned == 'Mt Talomo' || assigned == 'Mount Talomo'
        ? ['Mt. Talomo', 'Mt Talomo', 'Mount Talomo']
        : [assigned];
    }

    function isAssignedMountainName(mountainName) {
      return isMountainHead()
        && mountainName is string
        && mountainName in assignedMountainNameVariants();
    }

    function guideCanClearActiveHikeRoom(userId) {
      let roomId = resource.data.get('activeHikeRoomId', '');
      return signedIn()
        && roomId is string
        && roomId != ''
        && request.resource.data.get('activeHikeRoomId', '') == ''
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activeHikeRoomId'])
        && get(
          /databases/$(database)/documents/hike_rooms/$(roomId)
        ).data.guideId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/hike_rooms/$(roomId)/participants/$(userId)
        ).data.get('membershipStatus', '') == 'removed';
    }

    function userHasSafetyDetails(userId) {
      let profile = get(
        /databases/$(database)/documents/users/$(userId)
      ).data;
      return profile.get('contactNumber', '') is string
        && profile.get('contactNumber', '') != ''
        && profile.get('emergencyContactName', '') is string
        && profile.get('emergencyContactName', '') != ''
        && profile.get('emergencyContactPhone', '') is string
        && profile.get('emergencyContactPhone', '') != '';
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        isTourismAdmin() ||
        (isMountainHead()
          && resource.data.accountType == 'tour_guide'
          && resource.data.get('mountainNames', []).hasAny(
            assignedMountainNameVariants()
          )) ||
        (!isAdmin() && resource.data.accountType == 'tour_guide') ||
        isOwner(userId)
      );

      // Every account starts as a hiker — there's no more direct "I'm a
      // tour guide" self-declaration at signup. Becoming a tour guide only
      // ever happens server-side, via reviewTourGuideApplication approving
      // a tour_guide_applications doc (see that collection below). "admin"
      // is blocked the same way — only trusted Admin SDK paths grant it.
      // Every field is read with .get(field, safe default): the app's real
      // sign-up payload (AuthDatabaseService.signUpUser) doesn't include
      // adminAccess / adminRole / managedMountainName at all, and reading a
      // missing field directly is an evaluation ERROR that denied every
      // email/password sign-up. A missing field is exactly as safe as its
      // default here, so this is no looser than before.
      allow create: if isOwner(userId)
        && request.resource.data.get('guideVerified', null) != true
        && request.resource.data.get('role', '') != 'admin'
        && request.resource.data.get('accountType', '') != 'admin'
        && request.resource.data.get('adminAccess', false) != true
        && request.resource.data.get('adminRole', null) == null
        && request.resource.data.get('managedMountainName', null) == null
        && request.resource.data.get('role', '') != 'tour_guide'
        && request.resource.data.get('accountType', '') != 'tour_guide';

      allow update: if (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'role',
            'accountType',
            'guideVerified',
            'accountTypeConfirmed',
            'adminRole',
            'adminAccess',
            'managedMountainName',
            'mountainName',
            'mountainNames',
            'mountainsHandled'
          ])
      ) || guideCanClearActiveHikeRoom(userId);

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId);
      }

      match /hikes/{hikeId} {
        allow read, create: if isOwner(userId);
      }

      match /public/{docId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
    }

    match /app_content/{documentId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /community_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() < 100
        && request.resource.data.content is string
        && request.resource.data.content.size() < 2000
        && request.resource.data.mountainName is string
        && request.resource.data.mountainName.size() < 200;
      // Three distinct legitimate writers, each restricted to only the
      // fields their action actually touches: the author editing their own
      // post; anyone toggling their own like (+1/-1 on likeCount only, via
      // the transaction in _toggleCommunityPostLike); anyone adding/
      // deleting their own comment (+1/-1 on commentCount only, via the
      // transactions in _addCommunityComment/_deleteCommunityComment).
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likeCount', 'updatedAt']) &&
          (request.resource.data.likeCount == resource.data.likeCount + 1 ||
            request.resource.data.likeCount == resource.data.likeCount - 1)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['commentCount', 'updatedAt']) &&
          (request.resource.data.commentCount == resource.data.commentCount + 1 ||
            request.resource.data.commentCount == resource.data.commentCount - 1)
        )
      );
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() < 1000;
        allow update: if signedIn() && (
          resource.data.authorId == request.auth.uid ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likeCount']) &&
            (
              request.resource.data.likeCount ==
                (resource.data.likeCount is int
                  ? resource.data.likeCount + 1
                  : 1) ||
              request.resource.data.likeCount ==
                (resource.data.likeCount is int
                  ? resource.data.likeCount - 1
                  : 0)
            )
          )
        );
        allow delete: if signedIn()
          && resource.data.authorId == request.auth.uid;

        match /likes/{userId} {
          allow read: if signedIn();
          allow create, update, delete: if isOwner(userId);
        }
      }

      match /likes/{userId} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(userId);
      }
    }

    match /hike_rooms/{roomId} {
      allow read: if signedIn()
        && (
          !isAdmin() ||
          isTourismAdmin() ||
          isAssignedMountainName(resource.data.get('mountainName', ''))
        );
      allow create: if signedIn()
        && request.resource.data.guideId == request.auth.uid;
      // The guide can edit room details and start the room. Ending is handled
      // by the endHikeRoom callable so participant memberships and user room
      // pointers are cleaned up together. A joining or leaving participant
      // only touches `updatedAt` on this room document.
      allow update: if signedIn() && (
        (resource.data.guideId == request.auth.uid
          && (request.resource.data.status != 'ended'
            || resource.data.status == 'ended')) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
      );

      match /participants/{participantId} {
        allow read: if signedIn()
          && (
            !isAdmin() ||
            isTourismAdmin() ||
            (isAssignedMountainName(get(
              /databases/$(database)/documents/hike_rooms/$(roomId)
            ).data.get('mountainName', '')))
          );
        // Every participant doc is created by its own owner (createRoom
        // for the guide, joinRoom for a hiker) — doc id and userId field
        // both equal the creator's own uid.
        allow create: if signedIn()
          && participantId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && (
            get(
              /databases/$(database)/documents/hike_rooms/$(roomId)
            ).data.guideId == request.auth.uid
            || userHasSafetyDetails(request.auth.uid)
          );
        // Either the participant themself (activity status, leaving the
        // room) or the room's guide acting on someone else (kickParticipant).
        allow update: if signedIn() && (
          participantId == request.auth.uid ||
          get(/databases/$(database)/documents/hike_rooms/$(roomId)).data.guideId
            == request.auth.uid
        );

      }

      match /sos_events/{eventId} {
        allow read: if signedIn() && (
          isTourismAdmin() ||
          !isAdmin() ||
          (isAssignedMountainName(resource.data.get('mountainName', '')) ||
            (isMountainHead() && isAssignedMountainName(get(
              /databases/$(database)/documents/hike_rooms/$(roomId)
            ).data.get('mountainName', ''))))
        );
        // Creation goes through the sendSosEvent Cloud Function only (see
        // functions/index.js), which re-verifies room/participant status
        // server-side and enforces a per-user cooldown before writing via
        // the Admin SDK (which bypasses these rules) — a direct client
        // write here could skip both of those checks, so it's disallowed.
        allow create: if false;
        // Only the room's guide can acknowledge an SOS (acknowledgeSos in
        // hike_room_service.dart), and only those four fields — never the
        // location/sender data the event was created with.
        allow update: if signedIn()
          && get(/databases/$(database)/documents/hike_rooms/$(roomId)).data.guideId
            == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acknowledgedBy', 'acknowledgedAt', 'updatedAt']);
      }

      // Written only by sendSosEvent via the Admin SDK — never read or
      // written directly by any client.
      match /sos_cooldowns/{uid} {
        allow read, write: if false;
      }
    }

    // Enables the admin dashboard to count active SOS events with a
    // collection-group query across every hike room.
    match /{path=**}/sos_events/{eventId} {
      allow read: if isTourismAdmin()
        || isAssignedMountainName(resource.data.get('mountainName', ''));
    }

    match /trail_submissions/{submissionId} {
      // Admin dashboards need to read submissions beyond the caller's own —
      // without the appropriate Tourism Admin or mountain-scoped role here,
      // that query is rejected outright (Firestore refuses a list query
      // it can't prove is fully authorized, it doesn't just filter).
      allow read: if signedIn()
        && (
          resource.data.submittedBy == request.auth.uid ||
          isTourismAdmin() ||
          isAssignedMountainName(resource.data.get('mountainName', ''))
        );
      allow create: if signedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /mountain_trails/{trailId} {
      allow read: if true;
      allow write: if false;
    }

    // Organizer/guide contact info per mountain — public read, same as
    // mountain_trails (there's no client write path for this anywhere in
    // the app; entries are managed out-of-band).
    match /mountain_organizers/{organizerId} {
      allow read: if true;
      allow write: if false;
    }

    // Device identity and immutable connectivity history are written by
    // updateParticipantBluetoothStatus via the Admin SDK.
    match /bluetooth_devices/{deviceId} {
      allow read: if isTourismAdmin();
      allow write: if false;

      match /activity/{activityId} {
        allow read: if isTourismAdmin();
        allow write: if false;
      }
    }

    // A hiker's "Apply as Tour Guide" submission (ID/certificate photos,
    // experience). Only the applicant or an admin can read it — it
    // includes government ID. Status can only move off "pending" via
    // Tourism Admin's reviewTourGuideApplication Admin SDK write (see
    // functions/adminActions.js) — never directly by any client, which is
    // what stops an applicant from just marking their own application
    // approved.
    match /tour_guide_applications/{applicationId} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        isTourismAdmin() ||
        (isMountainHead()
          && resource.data.get('mountainNames', []).hasAny(
            assignedMountainNameVariants()
          )) ||
        isAssignedMountainName(resource.data.get('mountainsHandled', ''))
      );
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // Written only by reviewTourGuideApplication (functions/adminActions.js)
    // via the Admin SDK — never directly by any client.
    match /admin_actions/{actionId} {
      allow read: if isTourismAdmin();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isTourismAdmin()
        || (isMountainHead()
          && resource.data.get('type', '') in [
            'sos', 'trail_submission', 'incident_report'
          ]
          && isAssignedMountainName(resource.data.get('mountainName', '')));

      allow create: if false;
      allow delete: if false;

      allow update: if request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['isRead'])
        && (
          isTourismAdmin() ||
          (isMountainHead()
            && resource.data.get('type', '') in [
              'sos', 'trail_submission', 'incident_report'
            ]
            && isAssignedMountainName(resource.data.get('mountainName', '')))
        );
    }

    // A hiker's own live location while they're in Hiking Mode, kept only
    // so sendNearbySos (functions/nearbySos.js) can find the hikers
    // closest to a solo SOS. Write-only for the owner — no client, not
    // even another hiker, can read anyone's location; only the Cloud
    // Function (Admin SDK) does. Deleted again when the hike ends.
    match /hiker_presence/{userId} {
      allow read: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['latitude', 'longitude', 'updatedAt'])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    // Written only by sendNearbySos via the Admin SDK.
    match /solo_sos_events/{eventId} {
      allow read: if isTourismAdmin();
      allow write: if false;
    }

    match /incident_reports/{reportId} {
      allow read: if signedIn() && (
        isTourismAdmin() ||
        resource.data.get('guideId', '') == request.auth.uid ||
        isAssignedMountainName(resource.data.get('mountainName', ''))
      );
      allow write: if false;
    }

    match /hike_room_history/{roomId} {
      allow read: if signedIn() && (
        isTourismAdmin() ||
        isAssignedMountainName(resource.data.get('mountainName', ''))
      );
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
